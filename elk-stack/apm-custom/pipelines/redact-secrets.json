{
  "description": "Redact secret query-string values from URL-bearing fields",
  "processors": [
    {
      "gsub": {
        "field": "url.original",
        "pattern": "(?i)((?:^|[?&])(?:apikey|api_key|api%5fkey|token|access_token|auth|password|signature)=)[^&#\"\\s]*",
        "replacement": "$1REDACTED",
        "ignore_missing": true
      }
    },
    {
      "gsub": {
        "field": "url.full",
        "pattern": "(?i)((?:^|[?&])(?:apikey|api_key|api%5fkey|token|access_token|auth|password|signature)=)[^&#\"\\s]*",
        "replacement": "$1REDACTED",
        "ignore_missing": true
      }
    },
    {
      "gsub": {
        "field": "url.query",
        "pattern": "(?i)((?:^|[?&])(?:apikey|api_key|api%5fkey|token|access_token|auth|password|signature)=)[^&#\"\\s]*",
        "replacement": "$1REDACTED",
        "ignore_missing": true
      }
    },
    {
      "gsub": {
        "field": "message",
        "pattern": "(?i)((?:^|[?&])(?:apikey|api_key|api%5fkey|token|access_token|auth|password|signature)=)[^&#\"\\s]*",
        "replacement": "$1REDACTED",
        "ignore_missing": true
      }
    },
    {
      "gsub": {
        "field": "labels.RequestPath",
        "pattern": "(?i)((?:^|[?&])(?:apikey|api_key|api%5fkey|token|access_token|auth|password|signature)=)[^&#\"\\s]*",
        "replacement": "$1REDACTED",
        "ignore_missing": true
      }
    }
  ],
  "on_failure": [
    {
      "remove": {
        "field": "url.original",
        "ignore_missing": true
      }
    },
    {
      "remove": {
        "field": "url.full",
        "ignore_missing": true
      }
    },
    {
      "remove": {
        "field": "url.query",
        "ignore_missing": true
      }
    },
    {
      "remove": {
        "field": "message",
        "ignore_missing": true
      }
    },
    {
      "remove": {
        "field": "labels.RequestPath",
        "ignore_missing": true
      }
    },
    {
      "set": {
        "field": "error.message",
        "value": "{{ _ingest.on_failure_message }}"
      }
    }
  ]
}
